---
import MailLogo from '../assets/mail.svg';
import GithubLogo from '../assets/github_logo.svg';
---


<footer class="bg-primary-100 text-accent-200 py-4 md:flex md:justify-center">
  <div class="container text-center flex flex-col items-center gap-4 max-w-[1440px] md:items-start md:pl-2 md:ml-10 md:border-l md:border-primary-300">
    <div class="text-left">
        <p class="text-center md:text-left">Tyler Gaw - 2026</p>
        <div class="w-fit h-fit flex items-center gap-2">
            <div class="w-6 h-6 inline-block">
                <MailLogo/>
            </div>
            tyler.agaw@gmail.com
        </div>
        <div class="w-fit h-fit flex items-center gap-2">
            <div class="w-6 h-6 inline-block rounded-full bg-accent-200">
                <GithubLogo/>
            </div>
            tagaw
        </div>
    </div>
  </div>
</footer>