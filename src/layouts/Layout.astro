---
import Footer from '../component/Footer.astro';
import Navbar from '../component/Navbar.astro';
import '../styles/global.css'

interface Props {
	title: string;
	description: string;
	spa?:boolean;
}

const { title, description, spa = false } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/temp.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={ description } />
		<title>{ title }</title>
	</head>
	
	<body class="h-fit w-screen bg-primary-100 flex flex-col min-w-[200px] max-w-screen overflow-x-hidden ">
		{spa ? 
		<div class="h-screen w-full flex flex-col">
			<Navbar/>
			<slot />
		</div>
		:
		<Navbar/>
		<slot />}
		<Footer/>
	</body>
</html>
