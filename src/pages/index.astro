---
import '../styles/global.css'
import Colors from '../component/Colors.astro'
import RainbowText from '../component/RainbowText.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Home - Tyler Gaw" description="Personal Website of Tyler Gaw">
	<!-- <Colors/> -->
	
	<div class="w-full h-fit bg-bg-300 text-text-100 flex flex-none justify-center">
		<div class="max-w-7xl w-full my-8 md:my-16">
			<div class="w-3/4 h-full mx-auto text-center font-bold grid grid-rows-2 md:gap-8">
				<div class="text-center flex flex-col justify-center items-center md:row-span-2 text-4xl xl:text-7xl md:text-6xl">
					<RainbowText>hello, world</RainbowText>
				</div>
				<!-- maybe a picture -->
				<div class="mx-auto rounded-lg h-full">
					<p class="xl:text-6xl md:text-4xl text-3xl">I am</p>
					<p class="xl:text-7xl md:text-6xl text-4xl">Tyler Gaw</p>
				</div>
			</div>
		</div>
	</div>
	
	<div class="w-full h-fit bg-bg-100 text-text-200">
		<div class="max-w-4xl mx-auto p-8 text-center md:text-xl xl:text-2xl my-4">
			
			<p>Welcome to my website where I showcase my projects and interests. Below are some of the projects I've been working on</p>

			<div class="my-4 border-4 w-fit  mx-auto rounded-lg bg-linear-to-br from-blue-500 to-red-500 via-green-500 bg-size-[400%_400%] animate-panning bg-clip-border border-transparent">
				<div class="w-full h-full bg-bg-100 px-2 rounded-md">
					<RainbowText>highlighted projects</RainbowText>
				</div>
			</div>
			<div class="w-full h-48"></div>
			<p>explore some of my other projects on my</p>
			<h1 class="mt-2 underline">Projects</h1><span>page</span>
			
		</div>
	</div>
</Layout>
