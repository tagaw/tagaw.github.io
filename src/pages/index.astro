---
import '../styles/global.css'
import Navbar from '../component/Navbar.astro'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/temp.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<Navbar/>
		<div class="absolute top-0 shadow-xl w-full h-screen flex text-center justify-center items-center xl:text-9xl md:text-8xl text-6xl font-extrabold bg-black">
			<p class="bg-linear-to-br from-blue-500 to-red-500 via-green-500 bg-size-[400%_400%] bg-clip-text text-transparent text-glow animate-panning">
				hello, world
			</p>
			<!-- divider -->
			<div class="w-[70vw] absolute top-[95vh] h-[10vh] bg-neutral-500 rounded"></div>
		</div>
		
		<div class="w-full h-screen h-fit bg-white top-[100vh] relative">
			<div class="w-3/4 h-full mx-auto text-center font-bold grid grid-rows-3">
				<div class="text-center flex flex-col justify-center items-center">
					<p class="xl:text-7xl md:text-6xl text-4xl">I am</p>
					<p class="xl:text-8xl md:text-7xl text-5xl">Tyler Gaw</p>
				</div>
				<!-- maybe a picture -->
				<div class="mx-auto border-1 rounded-lg h-full">
					<img src="../public/temp.png" alt="Picture of me" class="mx-auto h-full rounded-lg object-cover"/>
				</div>
				<p class="xl:text-7xl md:text-6xl text-4xl text-center flex flex-col justify-center items-center">Welcome to my website</p>
			</div>
		</div>

		<div class="w-full h-screen"></div>
	</body>
</html>
